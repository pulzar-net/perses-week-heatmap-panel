{
  "name": "@pulzr/perses-week-heatmap-panel",
  "version": "0.2.0",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "npm run build-mf && concurrently \"npm:build:*\"",
    "build-mf": "rsbuild build",
    "build:esm": "swc ./src -d dist/lib --strip-leading-paths --config-file .swcrc",
    "build:types": "tsc --project tsconfig.build.json",
    "lint": "oxlint src",
    "lint:fix": "oxlint --fix src",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "cross-env LC_ALL=C TZ=UTC vitest run",
    "type-check": "tsc --noEmit"
  },
  "main": "lib/index.js",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "dependencies": {
    "react-compiler-runtime": "^1.0.0"
  },
  "devDependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@module-federation/rsbuild-plugin": "^2.9.1",
    "@mui/material": "6.5.0",
    "@perses-dev/client": "0.56.0-beta.1",
    "@perses-dev/components": "0.56.0-beta.1",
    "@perses-dev/dashboards": "0.56.0-beta.1",
    "@perses-dev/explore": "0.56.0-beta.1",
    "@perses-dev/plugin-system": "0.56.0-beta.1",
    "@rsbuild/core": "^2.2.13",
    "@rsbuild/plugin-react": "^2.1.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.18",
    "@tanstack/react-query": "5.106.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/node": "^24.13.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.3.0",
    "concurrently": "^10.0.5",
    "cross-env": "^7.0.3",
    "date-fns": "4.4.0",
    "jsdom": "^27.0.0",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-plugin-react-doctor": "0.9.12",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@emotion/react": "^11.7.1",
    "@emotion/styled": "^11.6.0",
    "@hookform/resolvers": "^5.9.1",
    "@mui/material": "^6.1.10",
    "@perses-dev/client": "^0.56.0-beta.1",
    "@perses-dev/components": "^0.56.0-beta.1",
    "@perses-dev/dashboards": "^0.56.0-beta.1",
    "@perses-dev/explore": "^0.56.0-beta.1",
    "@perses-dev/plugin-system": "^0.56.0-beta.1",
    "@perses-dev/spec": "^0.3.0",
    "@tanstack/react-query": "^5.105.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "echarts": "6.1.0",
    "immer": "^11.2.9",
    "lodash": "^4.17.21",
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0",
    "react-hook-form": "^7.87.0",
    "use-resize-observer": "^10.0.0"
  },
  "files": [
    "lib/**/*",
    "__mf/**/*",
    "mf-manifest.json",
    "mf-stats.json"
  ],
  "packageManager": "npm@11.17.0",
  "perses": {
    "metadata": {
      "name": "PulzrWeekHeatmapPanel",
      "registry": "pulzr"
    },
    "schemasPath": "schemas",
    "plugins": [
      {
        "kind": "Panel",
        "spec": {
          "display": {
            "name": "Week heatmap"
          },
          "name": "PulzrWeekHeatmapPanel"
        }
      }
    ]
  },
  "description": "Perses panel: a weekday × hour heatmap, such as occupancy by hour of the week",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pulzar-net/perses-week-heatmap-panel.git"
  },
  "homepage": "https://github.com/pulzar-net/perses-week-heatmap-panel#readme",
  "publishConfig": {
    "access": "public"
  }
}
